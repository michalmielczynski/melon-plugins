# Track ONLY melon.bar and melon.dock; ignore every other plugin, nested repos,
# and local backup/temp files. This keeps the repo focused on OUR custom work.

/*
!/.gitignore
!/melon.bar/
!/melon.dock/
!/melon.eye/
!/melon.sony/

# local backups / temp
*.bak
*.bak.*
*.orig
*~
*.swp

# melon.sony: runtime helpera i cache pythona
.state/
__pycache__/
